# ==========================================
ros_ws/src/fast_lio/Log/*
ros_ws/src/fast_lio/PCD/*
# Keep placeholders if any
!ros_ws/src/fast_lio/Log/.gitkeep
!ros_ws/src/fast_lio/PCD/.gitkeep

